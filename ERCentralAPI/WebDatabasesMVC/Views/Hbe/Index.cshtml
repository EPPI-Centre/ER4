                                visualHTML += "</tr>";

                                visualHTML += "<tr>";
                                visualHTML += "<td width='33%' style='padding: 5px 5px 0px 5px; cursor: pointer;' onclick='javascript:GoToHbeItemDetails(" + itemId + ")'>";
                                visualHTML += "<h5><b>Volume</b></h5>"
                                visualHTML += "</td>";
                                visualHTML += "<td>";
                                visualHTML += evidenceVolumeIcon;
                                visualHTML += "</td>";
                                visualHTML += "</tr>";

                                visualHTML += "</table>";

                                visualHTML += "</div>";
                                visualHTML += "</div>";
                                //-------------------------------------------------------

                            }

                            if (itemCounter == 3) {

                                visualHTML += "<div class='col-12 col-sm-10 col-md-6 col-lg-3' max-height: 150px;>";

                                //-----------------------------------------------------
                                visualHTML += "<div class='card' >";
                                switch (outcomeValue)
                                {
