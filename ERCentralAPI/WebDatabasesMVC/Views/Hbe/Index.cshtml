                            }

                            visualHTML += "</div>";

                            if (itemCounter == 3) {
                                itemCounter = 0;
                                visualHTML += "</div>";
                            }
                            else {
                                itemCounter +=1;
                            }
                }

                globalCounter += 1;
                if (globalCounter == documentData.items.totalItemCount) {
                    let resultsDiv = $("#visualsHBEDiv");
                    resultsDiv.html(visualHTML);
                    globalCounter = 0;
                    searchFor = "";
                    itemCounter = 0;
                }
            }

        }
        else {
            console.log("error", "unable to get data");
        }
    }





