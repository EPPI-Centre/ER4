        console.log("webDbData", ListData);
        loadingDiv.show();
        attributeIdFilter = ListData.webDb.attributeIdFilter;
        $.post(pathRoot + "ItemList/GetFreqListJSon"
            , { attId: attributeIdFilter, attName: 'test' }
            , function (data, result) { itemData(data, result); }
        ).fail((response) => {handleFreqsError(response); loadingDiv.hide(); });
    }


    async function itemData(data, result) {
        if (result == "success") {
            var CurrentDelay = 80;//milliseconds!
            var DelayIncrement = 100; //100 milliseconds;
            const delayCommand = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
            documentData = data;
            console.log("documentData", documentData, result);
            
            var IterationsWithoutError = 1;
            for (var i = 0; i < documentData.items.totalItemCount; i++) {
                loadingDiv.html("Loading: " + (i+1).toString() + " of " + documentData.items.totalItemCount.toString());
                    await $.ajax({
                        url: pathRoot + "Coding/FetchItemCodingJSON",
                        type: 'POST',
                        data: { ItemId: documentData.items.items[i].itemId },
                        datatype: 'json'
                    })
                    .done(function (data, result) {
                        //console.log("Is this success?", result);
                        if (result === "success") buildArrayOfCodingData(data, result, i);
                    })
                    .catch(async function (jqErr, textStatus, errorThrown) { 
                        console.log("catch block, error on:", jqErr, textStatus, errorThrown, i);
                        if (jqErr.status == 429){
                            const waitfor = jqErr.getResponseHeader("retry-after");
                            if (!waitfor) waitfor = 1;
                            var possibleNewDelay = (1000 * waitfor)/(IterationsWithoutError);
                            if (possibleNewDelay > DelayIncrement) DelayIncrement = possibleNewDelay;
                            CurrentDelay = CurrentDelay + DelayIncrement;
                            console.log("New per call delay:", CurrentDelay);
                            IterationsWithoutError = 1;
                            i = i - 1;
                            await delayCommand((1000 * waitfor) - CurrentDelay);//wait for the amount of time we're told to, minus the amount we'll wait anyway before looping
                        }
                        else {
                            loadingDiv.hide();
                            alert("Unexpected error - data failed to load, please try again. \r\nError status code is: "  + jqErr.status.toString()
                                + ". \r\nError message is: " + jqErr.statusText);
                            throw(jqErr);
                        }
                        
                    });
                await delayCommand(CurrentDelay);
                IterationsWithoutError++;
            }
            loadingDiv.hide();
        }
        else {
            console.log("error", "unable to get data");
        }
    }

    function buildArrayOfCodingData(codingData, result, i) {
        if (result == "success") {
            SavedCodingData.push(codingData);
            //var jat = $("#justATest");
            //if (jat) jat.html("Coding data count:" + SavedCodingData.length.toString());
            buildCard(SavedCodingData[i], result, i);
        }
    }

