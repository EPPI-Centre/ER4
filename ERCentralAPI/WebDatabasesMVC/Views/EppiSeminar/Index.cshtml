    function getItemDetails(ItemIndexValue, seminarCompleteData, meetingLinkData, recordingLinkData) {
        //a) full title (title field) 
        //b) date (year field) 
        //c) Session information (abstract field), 
        //d) Speaker (author field) and 
        //e) Recording link (URL field).

        //var titleElement = document.getElementById("exampleModalLabel");
        //titleElement.innerhtml = documentData.items.items[ItemIndex].title;


        //var title = documentData.items.items[ItemIndex].title; 
        var element = document.getElementById("seminarDetailsDiv");
        detailsHTML = "<p>";
        detailsHTML += "<p><b>" + documentData.items.items[ItemIndexValue].title + "</b></p>";
        detailsHTML += "<p><b>Presenters: </b>" + documentData.items.items[ItemIndexValue].authors + "</p>";
        detailsHTML += "<p><b>Date of seminar: </b>" + documentData.items.items[ItemIndexValue].comments + "</p>";
        detailsHTML += "<p><b>Session details</b><br>" + documentData.items.items[ItemIndexValue].abstract + "</p>";
        detailsHTML += "</p>";
        detailsHTML += "<p>";
        if (seminarCompleteData == 0) {
            if ((meetingLinkData == "undefined") || (meetingLinkData == "")) {
                detailsHTML += "Meeting details not available";
            }
            else {
                detailsHTML += "<a href='" + meetingLinkData + "' target='_blank'>Meeting link</a>";
            }
        }
        else {
            if ((recordingLinkData == "undefined") || (recordingLinkData == "")) {
                detailsHTML += "Recording not availaable";
            }
            else {
                detailsHTML += "<a href='" + recordingLinkData + "' target='_blank'>Recording link</a>";
            }

        }
        //detailsHTML += "<button onclick='location.href='" + recordingLinkData + "' target='_blank'>Recording link</button>";
        detailsHTML += "<p>";

        element.innerHTML = detailsHTML;
    }


