{
    "AppSettings": {
        "EPPIApiClientSecret": "***Placeholder***",
        "EPPIApiClientName": "***Placeholder***",
        "DataServiceDB": "Server=localhost;Database=Presenter;Integrated Security=True;",
        "ER4DB": "Server=localhost;Database=Reviewer;Integrated Security=True;",
        "ER4AdminDB": "Server=localhost;Database=ReviewerAdmin;Integrated Security=True;",
        //Use setting below to enter logs into SQL Log table.
        //If set to true and no Log database exist the exception
        // thrown will indicate SERILOG Missing.  See below
        "UseDatabaseLogging": "false",
        "FAIRprojectId": 14,
        "VawgProjectId": 16,
        "FAIRImagesRoot": "http://localhost/FAIR-Images/", //"https://upload.wikimedia.org/wikipedia/"
        "ItemListTimeoutHandling": "typespecific"
    },
    "RateLimiting": [
        { //Current best values: 1s, 80 requests - this applies to static files only
            "PolicyName": "Global",
            "WindowInSeconds": 1,
            "PermitLimit": 80
        },
        {//Current best values: 1s, 10 requests - standard API endpoints
            "PolicyName": "RegularApiEndPoints",
            "WindowInSeconds": 1,
            "PermitLimit": 10
        },
        { //Current best values: 5s, 10 requests - item lists, frequencies, years histogram
            "PolicyName": "HighCostEndpoints",
            "WindowInSeconds": 5,
            "PermitLimit": 10
        },
        { //Current best values: 8s, 2 requests - maps and crosstabs
            "PolicyName": "MaxCostEndpoints",
            "WindowInSeconds": 8,
            "PermitLimit": 2
        }
    ],

    "Logging": {//not used
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Serilog": {
        "MinimumLevel": "Error"
    },
    "AllowedHosts": "*"
}
